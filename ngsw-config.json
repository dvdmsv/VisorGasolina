{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/assets/**",
          "!/historico/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "historico",
      "urls": ["/historico/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 60,
        "maxAge": "7d"
      }
    }
  ],
  "navigationRequestStrategy": "performance"
}
